# Public domain name for this installation (used in Traefik routing and the app URL)
DOMAIN=""

# Email address for Let's Encrypt certificate expiry notifications
LE_EMAIL=""

# Password for the /setup HTTP Basic Auth prompt (nginx enforces this)
APP_PASSWORD=""

# MariaDB connection details
MYSQL_HOST="mariadb"
MYSQL_PORT="3306"
MYSQL_USER="root"
MYSQL_PASSWORD=""
MYSQL_PF_DB_NAME="pathfinder"
MYSQL_UNIVERSE_DB_NAME="eve_universe"
MYSQL_CCP_DB_NAME="eve_lifeblood_min"

# Redis connection details
REDIS_HOST="redis"
REDIS_PORT="6379"

# CCP SSO OAuth2 credentials — create an application at https://developers.eveonline.com/applications
CCP_SSO_CLIENT_ID=""
CCP_SSO_SECRET_KEY=""

# ESI scopes requested during SSO login — only change if you know what you're removing
CCP_ESI_SCOPES="esi-location.read_online.v1,esi-location.read_location.v1,esi-location.read_ship_type.v1,esi-ui.write_waypoint.v1,esi-ui.open_window.v1,esi-universe.read_structures.v1,esi-corporations.read_corporation_membership.v1,esi-clones.read_clones.v1,esi-characters.read_corporation_roles.v1,esi-search.search_structures.v1"

# WebSocket server connection (must match the socket container's host/port)
PATHFINDER_SOCKET_HOST="pathfinder-socket"
PATHFINDER_SOCKET_PORT="5555"

# F3 debug/error detail level: 0=none, 1=errors only, 2=+stack trace, 3=full debug
# Set to 0 in production
PF_DEBUG="0"

# Display name for this Pathfinder installation (shown in the UI and emails)
PF_INSTALL_NAME="Pathfinder"

# Whether new users can register: 1=open, 0=locked (existing users can still log in)
PF_REGISTRATION_STATUS="1"

# CCP character ID of the SUPER admin (has full access to all maps and admin features)
PF_SUPER_ADMIN_ID=""

# Login whitelists — restrict access to specific CCP IDs (comma-separated)
# Leave blank to allow all characters/corporations/alliances
PF_LOGIN_WHITELIST_CHAR=""
PF_LOGIN_WHITELIST_CORP=""
PF_LOGIN_WHITELIST_ALLIANCE=""
