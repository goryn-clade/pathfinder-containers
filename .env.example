# Public domain name for this installation (used in Traefik routing and the app URL)
DOMAIN=""

# Internal server name — used as a cache key prefix (md5 seed) and in ESI User-Agent headers
# Should be unique per installation; does not need to match DOMAIN
SERVER_NAME="pathfinder"

# Email address for Let's Encrypt certificate expiry notifications
LE_EMAIL=""

# Password for the /setup HTTP Basic Auth prompt for "pf" user (nginx enforces this)
# Generate with: openssl rand -hex 16  (or any strong password)
# If wrong or empty: nginx returns 401; /setup is inaccessible.
APP_PASSWORD=""

# Enables the /setup wizard route. Set to 1 for first-time DB bootstrap, then back to 0.
# When 0, the controller returns 404 even if nginx Basic Auth succeeds.
PF_SETUP_ENABLED="0"

# MariaDB connection details
MYSQL_HOST="pf-db"
MYSQL_PORT="3306"
MYSQL_USER="root"
# Generate with: openssl rand -hex 32
MYSQL_PASSWORD=""
MYSQL_PF_DB_NAME="pathfinder"
MYSQL_UNIVERSE_DB_NAME="eve_universe"
MYSQL_CCP_DB_NAME="eve_lifeblood_min"

# Session cookie security: set to 1 on HTTPS deployments (production), 0 for HTTP dev
SESSION_COOKIE_SECURE="1"

# Redis connection details
REDIS_HOST="pf-redis"
REDIS_PORT="6379"
# Optional: set a strong random password to require Redis authentication.
# Leave blank to run without auth (only safe when Redis is not exposed beyond the Docker network).
# Generate with: openssl rand -hex 32
REDIS_PASSWORD=""

# CCP SSO OAuth2 credentials — create an application at https://developers.eveonline.com/applications
# If wrong or empty: SSO logins fail with "invalid_client" at the CCP token-exchange step; existing sessions keep working.
# To rotate: generate a new secret at the CCP developer portal, update this value, then restart pf.
CCP_SSO_CLIENT_ID=""
CCP_SSO_SECRET_KEY=""

# PKCE (RFC 7636) kill-switch. Set to 0 to disable if CCP SSO changes break the PKCE flow.
# Default: 1 (enabled). Omitting this variable keeps PKCE on.
# CCP_SSO_USE_PKCE="1"

# 32-byte hex-encoded key for encrypting ESI access/refresh tokens at rest (F5).
# Generate with: openssl rand -hex 32
# Required: leaving this blank fails closed — all token reads return empty and users are forced through SSO.
# Rotating this key invalidates all stored tokens unless you re-encrypt first
# (see static/scripts/rotate-token-key.php and MIGRATION-v2-to-v3.md).
TOKEN_ENCRYPTION_KEY=""

# ESI scopes requested during SSO login — only change if you know what you're removing
CCP_ESI_SCOPES="esi-location.read_online.v1,esi-location.read_location.v1,esi-location.read_ship_type.v1,esi-ui.write_waypoint.v1,esi-ui.open_window.v1,esi-universe.read_structures.v1,esi-corporations.read_corporation_membership.v1,esi-clones.read_clones.v1,esi-characters.read_corporation_roles.v1,esi-search.search_structures.v1"

# WebSocket server connection (must match the socket container's host/port)
PATHFINDER_SOCKET_HOST="pf-socket"
PATHFINDER_SOCKET_PORT="5555"

# Comma-separated hostnames allowed to open WebSocket connections (matched against the Origin header).
# Example: WS_ALLOWED_ORIGINS=pathfinder.example.com,maps.example.com
# In production (APP_ENV=production) this must not be empty — pf-socket refuses to start if it is.
# In non-production environments localhost and 127.0.0.1 are always auto-allowed.
WS_ALLOWED_ORIGINS=""

# Shared secret for HMAC-signing WebSocket access tokens (binds tokens to the issuing PHP session).
# Generate with: openssl rand -hex 32  (produces 64 hex chars; minimum accepted: 32 hex chars)
# Must be identical in the pf and pf-socket containers.
# REQUIRED: pf-socket refuses to start if this is absent or shorter than 32 hex characters.
WS_TOKEN_SECRET=""

# Whether the app is running in production mode (used for startup guards)
# Set to "production" on any internet-facing deployment
APP_ENV="production"

# F3 debug/error detail level: 0=none, 1=errors only, 2=+stack trace, 3=full debug
# MUST be 0 on any internet-facing deployment — higher values expose full stack traces
PF_DEBUG="0"

# Display name for this Pathfinder installation (shown in the UI and emails)
PF_INSTALL_NAME="Pathfinder"

# Whether new users can register: 1=open, 0=locked (existing users can still log in)
PF_REGISTRATION_STATUS="1"

# CCP character ID of the SUPER admin (has full access to all maps and admin features)
PF_SUPER_ADMIN_ID=""

# Login whitelists — restrict access to specific CCP IDs (comma-separated)
# Leave blank to allow all characters/corporations/alliances
PF_LOGIN_WHITELIST_CHAR=""
PF_LOGIN_WHITELIST_CORP=""
PF_LOGIN_WHITELIST_ALLIANCE=""
