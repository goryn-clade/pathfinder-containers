<?xml version="1.0"?>
<ruleset name="pf-php8-compat">
  <description>PHP 8.3 compatibility check for pathfinder + websocket</description>
  <file>pathfinder/app</file>
  <file>websocket/app</file>
  <exclude-pattern>*/vendor/*</exclude-pattern>
  <exclude-pattern>*/tmp/*</exclude-pattern>
  <config name="testVersion" value="8.3-"/>
  <rule ref="PHPCompatibility">
    <!-- func_get_args() behavior note — informational only, not a compat break -->
    <exclude name="PHPCompatibility.FunctionUse.ArgumentFunctionsReportCurrentValue"/>
    <!-- Lib/Resource.php: 'resource' is soft-reserved but class predates PHP 7; renaming is out of scope -->
    <exclude name="PHPCompatibility.Keywords.ForbiddenNamesAsDeclared"/>
  </rule>
  <arg name="colors"/>
  <arg value="sp"/>
</ruleset>
